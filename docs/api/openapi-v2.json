{
  "components": {
    "schemas": {
      "ApiVersion": {
        "properties": {
          "path": {
            "type": "string"
          },
          "revision": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "`stable`, or `draft` while the version may still change in any way.",
            "type": "string"
          },
          "version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "path",
          "revision",
          "status"
        ],
        "type": "object"
      },
      "AuthMethods": {
        "properties": {
          "device_grant": {
            "description": "TVs and cars: the device authorization grant (RFC 8628).",
            "type": "boolean"
          },
          "password": {
            "description": "Email and password (`grant_type=password`).",
            "type": "boolean"
          },
          "password_reset": {
            "type": "boolean"
          },
          "providers": {
            "description": "Identity providers whose id token the server accepts.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "totp": {
            "description": "A second factor from an authenticator app.",
            "type": "boolean"
          }
        },
        "required": [
          "password",
          "providers",
          "device_grant",
          "totp",
          "password_reset"
        ],
        "type": "object"
      },
      "CreateTokenRequest": {
        "properties": {
          "expires_in_days": {
            "description": "Days until it stops working; absent for never.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "What it is for: \"backup script\".",
            "type": "string"
          },
          "scopes": {
            "description": "From `library:read`, `library:write`, `playback`, `user:write`, `remote`,\n`family:admin`, `admin` — only those the account has.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "type": "object"
      },
      "DeviceAuthorizationRequest": {
        "properties": {
          "device_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_name": {
            "description": "Shown to the person approving it: \"Living room TV\".",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "DeviceAuthorizationResponse": {
        "description": "RFC 8628 §3.2.",
        "properties": {
          "device_code": {
            "description": "Secret: the device polls `POST /auth/token` with it.",
            "type": "string"
          },
          "expires_in": {
            "format": "int64",
            "type": "integer"
          },
          "interval": {
            "description": "Seconds between polls.",
            "format": "int64",
            "type": "integer"
          },
          "user_code": {
            "description": "Shown on the screen: `ABCD-EFGH`.",
            "type": "string"
          },
          "verification_uri": {
            "description": "Where to type the code; empty when the server has no console address.",
            "type": "string"
          },
          "verification_uri_complete": {
            "description": "The same with the code filled in, for a QR code.",
            "type": "string"
          }
        },
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ],
        "type": "object"
      },
      "DeviceRequest": {
        "properties": {
          "device_kind": {
            "type": "string"
          },
          "device_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          }
        },
        "required": [
          "user_code",
          "device_kind",
          "expires_at"
        ],
        "type": "object"
      },
      "Discovery": {
        "properties": {
          "addresses": {
            "description": "Where the server answers, `scope` one of `public`, `lan`, `vpn`. A client\nraces them and keeps the fastest that answers with the same `id`.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "api": {
            "description": "Every API this server speaks.",
            "items": {
              "$ref": "#/components/schemas/ApiVersion"
            },
            "type": "array"
          },
          "auth": {
            "$ref": "#/components/schemas/AuthMethods"
          },
          "edition": {
            "description": "`core` for the open-source server; editions name themselves.",
            "type": "string"
          },
          "id": {
            "description": "The server's stable id: a client trusts a server by it, whichever address answered.",
            "type": [
              "string",
              "null"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "modules": {
            "description": "Optional capabilities, one key each; a missing key reads as `false`.",
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "edition",
          "version",
          "api",
          "auth",
          "modules",
          "addresses",
          "limits"
        ],
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "description": "The field, as a JSON Pointer into the request body or the query parameter's name.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "type": "object"
      },
      "Limits": {
        "properties": {
          "list_limit_default": {
            "format": "int64",
            "type": "integer"
          },
          "list_limit_max": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "list_limit_default",
          "list_limit_max"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "family": {
            "$ref": "#/components/schemas/MeFamily"
          },
          "id": {
            "type": "string"
          },
          "instance_role": {
            "description": "`admin` runs the server; `user` is everyone else.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "email_verified",
          "instance_role",
          "family"
        ],
        "type": "object"
      },
      "MeFamily": {
        "properties": {
          "can_generate": {
            "type": "boolean"
          },
          "can_upload": {
            "description": "What the caller may do in it, family admins' rights included.",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "description": "`admin` or `member`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "can_upload",
          "can_generate"
        ],
        "type": "object"
      },
      "PersonalToken": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "token": {
            "description": "The secret: only in the answer that created it.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "created_at"
        ],
        "type": "object"
      },
      "ProblemBody": {
        "description": "The body of every v2 error.",
        "properties": {
          "code": {
            "description": "Stable and machine-readable: `not_found`, `invalid_body`, `rate_limited`…",
            "type": "string"
          },
          "detail": {
            "description": "What went wrong, in English, for people; not meant to be matched on.",
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "description": "One entry per invalid field.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "The status's reason phrase.",
            "type": "string"
          },
          "type": {
            "description": "`urn:own-audio:problem:<code>`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "RevokeRequest": {
        "properties": {
          "token": {
            "description": "A refresh token (signs that device out) or a personal access token.",
            "type": "string"
          },
          "token_type_hint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "current": {
            "description": "The device making this request.",
            "type": "boolean"
          },
          "device_kind": {
            "type": "string"
          },
          "device_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "description": "The device's id; signing it out ends its refresh token and its access tokens.",
            "type": "string"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "signed_in_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "device_kind",
          "signed_in_at",
          "expires_at",
          "current"
        ],
        "type": "object"
      },
      "TokenRequest": {
        "properties": {
          "assertion": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_code": {
            "description": "device_code: from `POST /auth/device`.",
            "type": [
              "string",
              "null"
            ]
          },
          "device_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_name": {
            "description": "The device, for the session list (\"Anna's iPhone\"; `ios`, `android`, `web`, `tv`…).",
            "type": [
              "string",
              "null"
            ]
          },
          "full_name": {
            "description": "jwt-bearer, Apple only: the name Apple gives once, at the first sign-in.",
            "type": [
              "string",
              "null"
            ]
          },
          "grant_type": {
            "description": "`password`, `refresh_token`, `urn:ietf:params:oauth:grant-type:device_code`,\n`urn:ietf:params:oauth:grant-type:jwt-bearer` or\n`urn:own-audio:params:oauth:grant-type:mfa-otp`.",
            "type": "string"
          },
          "invite_code": {
            "description": "jwt-bearer: an invitation, when the account is new.",
            "type": [
              "string",
              "null"
            ]
          },
          "mfa_token": {
            "description": "mfa-otp: from the `mfa_required` answer, and the app's code or a recovery code.",
            "type": [
              "string",
              "null"
            ]
          },
          "otp": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "description": "jwt-bearer: `apple`, `google` or `microsoft`, and the provider's id token.",
            "type": [
              "string",
              "null"
            ]
          },
          "refresh_token": {
            "description": "refresh_token",
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "description": "password: the account's email.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "grant_type"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "description": "The OAuth 2.0 token response.",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds the access token is good for.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "refresh_token": {
            "description": "Rotates on every use; presenting a used one signs the device out.",
            "type": "string"
          },
          "scope": {
            "description": "What the token may do, space-separated.",
            "type": "string"
          },
          "token_type": {
            "description": "Always `Bearer`.",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "scope"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "An access token from `POST /api/v2/auth/token`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The own.audio API (own-audio/api design/DESIGN.md). Draft until our apps ship on it: it may change in any way until then.",
    "license": {
      "identifier": "AGPL-3.0-or-later",
      "name": "AGPL-3.0-or-later"
    },
    "title": "own.audio API v2",
    "version": "2.0-draft"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/own-audio": {
      "get": {
        "operationId": "discovery_well_known",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            },
            "description": ""
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {}
        ],
        "summary": "What this server is and offers",
        "tags": [
          "discovery"
        ],
        "x-permission": "public"
      }
    },
    "/api/v2/auth/device": {
      "post": {
        "operationId": "auth_device_authorization",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAuthorizationRequest"
              }
            }
          },
          "description": "As a form or JSON; may be empty",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthorizationResponse"
                }
              }
            },
            "description": ""
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {}
        ],
        "summary": "Start signing in a TV or car (RFC 8628): show `user_code` (or a QR code of `verification_uri_complete`), then poll `POST /auth/token` with `grant_type=urn:ietf:params:oauth:grant-type:device_code`",
        "tags": [
          "auth"
        ],
        "x-permission": "public"
      }
    },
    "/api/v2/auth/device/{user_code}": {
      "get": {
        "operationId": "auth_describe_device",
        "parameters": [
          {
            "description": "As shown; case, hyphens and look-alike characters are forgiven",
            "in": "path",
            "name": "user_code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRequest"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Missing, invalid or revoked access token"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Unknown, expired or already used"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "What a code on a TV is asking for, before approving it",
        "tags": [
          "auth"
        ],
        "x-permission": "user",
        "x-scope": "user:write"
      }
    },
    "/api/v2/auth/device/{user_code}/approve": {
      "post": {
        "operationId": "auth_approve_device",
        "parameters": [
          {
            "description": "As shown",
            "in": "path",
            "name": "user_code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Approved"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Missing, invalid or revoked access token"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Unknown, expired or already used"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Let the device in as the caller: its next poll gets tokens",
        "tags": [
          "auth"
        ],
        "x-permission": "user",
        "x-scope": "user:write"
      }
    },
    "/api/v2/auth/device/{user_code}/deny": {
      "post": {
        "operationId": "auth_deny_device",
        "parameters": [
          {
            "description": "As shown",
            "in": "path",
            "name": "user_code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Denied"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Missing, invalid or revoked access token"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Unknown, expired or already used"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Refuse the device",
        "tags": [
          "auth"
        ],
        "x-permission": "user",
        "x-scope": "user:write"
      }
    },
    "/api/v2/auth/revoke": {
      "post": {
        "description": "Revoke a token (RFC 7009). Answers `200` whether or not the token was\nknown, so it says nothing about which tokens exist.",
        "operationId": "auth_revoke",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RevokeRequest"
              }
            }
          },
          "description": "As a form, as OAuth clients send it; JSON is accepted too",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Revoked, or never known"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "Rate limited; see `Retry-After`"
          }
        },
        "security": [
          {}
        ],
        "summary": "Revoke a token (RFC 7009)",
        "tags": [
          "auth"
        ],
        "x-permission": "public"
      }
    },
    "/api/v2/auth/token": {
      "post": {
        "description": "Tokens for an account: a password, a refresh token, an approved device, a\nprovider's id token, or a two-factor code. An account with two-factor\nsign-in on answers the first step with `403 mfa_required` and an `mfa_token`\nfor the `mfa-otp` grant.",
        "operationId": "auth_token",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "description": "As a form, as OAuth clients send it; JSON is accepted too",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "OAuth `error`: `invalid_request`, `invalid_grant`, `unsupported_grant_type`; for the device code also `authorization_pending`, `slow_down`, `access_denied`, `expired_token`"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "`mfa_required`: finish with the `mfa-otp` grant and the `mfa_token` given"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            },
            "description": "`identity_conflict`: an account with the provider's email exists and the provider did not verify it"
          },
          "429": {
            "content": {
