# ──────────────────────────────────────────────────────────
# audio2 — backend-process environment
# Copy this file to backend/.env and fill in your values.
#
# SCOPE: this file configures the **backend process run directly**
# (`cargo run` from backend/, which is where dotenvy looks). It is NOT read
# by Docker — docker-compose.yml sets these variables itself, from the
# repo-root .env. See ../.env.example.
#
# The authoritative list of settings is src/app/config.rs, not this file.
# Nested fields use __ as separator: SERVER__PORT maps to config.server.port.
# ──────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__BASE_URL=http://localhost:8080

# ── Database ─────────────────────────────────────────────
# PostgreSQL only:
DATABASE_URL=postgres://audio2:audio2@localhost:5432/audio2

# ── Storage (S3-compatible: Garage, MinIO, AWS) ──────────
# Endpoint the backend talks to:
STORAGE__ENDPOINT=http://localhost:3900
# Endpoint browsers can reach (presigned URLs are signed against it).
# Defaults to STORAGE__ENDPOINT when unset:
# STORAGE__PUBLIC_ENDPOINT=http://localhost:3900
STORAGE__REGION=garage
STORAGE__BUCKET=audio2
STORAGE__ACCESS_KEY=<your-s3-access-key>
STORAGE__SECRET_KEY=<your-s3-secret-key>
STORAGE__PATH_STYLE=true
# Apply a permissive GET/HEAD CORS policy to the bucket at startup (default
# true). Set false if the bucket policy is managed elsewhere.
# STORAGE__SET_CORS=true

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH__SESSION_SECRET=changeme-generate-a-real-secret-please
# Deprecated alias for AUTH__ACCESS_TTL_SECS; used as the access-token TTL
# when AUTH__ACCESS_TTL_SECS is unset.
AUTH__SESSION_TTL_SECS=604800
# Access-JWT lifetime. Set to 3600 once your clients use POST /auth/refresh;
# unset ⇒ falls back to AUTH__SESSION_TTL_SECS.
# AUTH__ACCESS_TTL_SECS=3600
# Refresh-token lifetime (default 90 days).
# AUTH__REFRESH_TTL_SECS=7776000
AUTH__LOCAL_ENABLED=true
# Public self-registration (default false). Family invite codes work even when
# this is off, which is the normal way a family member joins.
# AUTH__REGISTRATION_OPEN=false
# Seed admin@audio2.local / admin when the users table is empty. Default false,
# and it must stay false anywhere reachable — it is a fixed credential with the
# admin role. A real deployment creates its first admin via POST /setup/complete.
AUTH__DEV_SEED_ADMIN=true

# Optional: Google Sign-In (native token exchange, not the browser redirect
# stubs at /auth/google/redirect). Unset ⇒ POST /auth/google answers 501 and
# GET /auth/providers reports it disabled. ENABLED defaults false even once
# the rest is set — flip it only at the public rollout (or back off to pull
# it). See docs/sso-payments-plan.md.
# AUTH__GOOGLE__CLIENT_IDS=
# AUTH__GOOGLE__DESKTOP_CLIENT_ID=
# AUTH__GOOGLE__DESKTOP_CLIENT_SECRET=
# AUTH__GOOGLE__WEB_CLIENT_ID=
# AUTH__GOOGLE__ENABLED=false

# Optional: Sign in with Apple. Unset ⇒ POST /auth/apple answers 501 and
# GET /auth/providers reports it disabled. Same ENABLED gate as Google above.
# See docs/sso-payments-plan.md.
# AUTH__APPLE__CLIENT_IDS=
# AUTH__APPLE__WEB_CLIENT_ID=
# AUTH__APPLE__ENABLED=false

# Optional: Stripe Checkout credit top-ups (card, Apple Pay, Google Pay all
# arrive through this one integration — enable wallets in the Stripe
# dashboard, no separate code path). Unset ⇒ POST /family/billing/topup
# answers 501 and GET /family/billing's payments.enabled is false. Also
# requires SERVER__BASE_URL to be set (success/cancel redirect URLs).
# See docs/sso-payments-plan.md.
# STRIPE__SECRET_KEY=
# STRIPE__WEBHOOK_SECRET=

# ── Google Cloud APIs (audiobook generation) ─────────────
# Used by the audiobook generation pipeline (docs/audiobook-generation-plan.md).
# Both are simple API keys (Google Cloud Console → APIs & Services →
# Credentials → Create API key), scoped to the relevant API.
# Translation API — Phase 4 (translate step). Without it, generation jobs
# that request a different target language than source will fail that stage.
# GOOGLE_CLOUD__TRANSLATE_API_KEY=
# Cloud Text-to-Speech API — Phase 6 (narration step). Without it, the
# narrating stage falls back to the stub/placeholder audio.
# GOOGLE_CLOUD__TTS_API_KEY=
# Gemini API — Phase 5 (LLM preprocessing: clean, chapterize, segment).
# Without it, that stage falls back to a rule-based segmenter instead of
# real LLM structuring. Needs the "Generative Language API" restriction
# enabled on the key (separate from Translate/TTS restrictions).
# GOOGLE_CLOUD__GEMINI_API_KEY=

# ── Worker ───────────────────────────────────────────────
# Comma-separated allowlist of job types this process's worker loop claims.
# Unset = claim everything, which is right for a single-process setup.
# docker-compose.yml uses this to split CPU-heavy ffmpeg assembly onto a
# dedicated container: the API gets
#   feed_refresh,stats_rollup,gen_pipeline
# and the assembler gets assemble_audiobook.
# WORKER_JOB_TYPES=

# ── Billing ──────────────────────────────────────────────
# Family storage credit ledger + daily storage-charge sweep. No real payments
# exist yet (no Stripe) — this only gates the play-money daily charge job;
# the ledger and GET /family/billing stay live either way. Off by default
# would leave self-hosters' credit balances frozen forever, which is fine.
# BILLING__CHARGES_ENABLED=true

# ── Microsoft sign-in ────────────────────────────────────────
# Entra app registration, `common` authority so work/school and personal
# Microsoft accounts can both sign in.
#
# No client secret: an app registered under "Mobile and desktop applications"
# is a public client, and Entra refuses one outright with AADSTS90023. PKCE
# secures the exchange instead. The setting exists because the same code path
# serves providers that do require one.
#
# ENABLED is a second gate on top of "configured at all": credentials can be
# set and exercised before the button appears for real users.
AUTH__MICROSOFT__ENABLED=false
AUTH__MICROSOFT__CLIENT_IDS=
AUTH__MICROSOFT__DESKTOP_CLIENT_ID=
AUTH__MICROSOFT__DESKTOP_CLIENT_SECRET=

# ── Music metadata (MusicBrainz mirror) ──────────────────
# Both must be set or `metadata` deserializes to None and music identify is
# silently unavailable — it does not error, the feature just isn't there.
#
# The shared mirror runs on the NUC and serves local dev, canary and
# production alike, so there is nothing to run locally. Point at
# http://localhost:8090 only when hacking on the service itself behind the
# `metadata` compose profile (see CLAUDE.md §8).
#
# The key must be the one the mirror you point at accepts; a freshly
# generated one gets a 401 from metadata.own.audio.
METADATA__BASE_URL=https://metadata.own.audio
# METADATA__API_KEY=

# ── Logging ──────────────────────────────────────────────
# RUST_LOG is what actually controls log output — it feeds tracing's EnvFilter
# in main.rs.
RUST_LOG=audio2=debug,info
# LOG_LEVEL deserializes into AppConfig but is only ever passed to a debug
# line; it does NOT affect log output. Kept for compatibility — use RUST_LOG.
# LOG_LEVEL=info
