# Copy to .env and set the two secrets. Everything else has a default.
POSTGRES_PASSWORD=
SESSION_SECRET=

# The address people and apps reach this server at. Media links are built
# from it, so it must be the address they really use.
PUBLIC_URL=http://localhost:8080

# Where media lives. `local` (default): the media_data volume, streamed by the
# server, nothing else to run. `s3`: an S3-compatible store; for the bundled
# RustFS also set COMPOSE_PROFILES=s3 and S3_SECRET_KEY.
# STORAGE_KIND=s3
# COMPOSE_PROFILES=s3
# S3_SECRET_KEY=
# S3_ENDPOINT=http://rustfs:9000
# The address browsers reach the store at (presigned media URLs).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Stream through the server instead (networks that block the store's host).
# S3_PROXY=true

# Optional: mail for invites, over SMTP submission. SMTP_SECURITY is `tls`
# (port 465, the default), `starttls` (587) or `none` (a relay on your own
# network, no password). MAIL_FROM is usually the mailbox you sign in as.
# SMTP_HOST=smtp.example.com
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# MAIL_FROM=you@example.com

# Optional: run the server as another user and group (default 1000:1000).
# PUID=1000
# PGID=1000

# Optional: another image or version (the default is the current pre-release on GHCR).
# SERVER_IMAGE=ghcr.io/own-audio/server:1.0.0-alpha.7
