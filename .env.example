# Copy to .env and set the three secrets. Everything else has a default.
POSTGRES_PASSWORD=
S3_SECRET_KEY=
SESSION_SECRET=

# The address people and apps reach this server at.
PUBLIC_URL=http://localhost:8080
# The address browsers reach the object store at (presigned media URLs).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Optional: another image or version (the default is the current pre-release on GHCR).
# SERVER_IMAGE=ghcr.io/own-audio/server:1.0.0-alpha.3
